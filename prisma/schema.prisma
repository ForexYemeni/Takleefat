// ============================================================
// Takleefat | تكليفات — Prisma Schema (PostgreSQL)
// منصة إدارة التكليفات الطبية والتمريضية
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- التعدادات (Enums) ----------

/// أدوار المستخدمين
enum Role {
  ADMIN
  NURSE
  RECEIVER
}

/// حالة الحساب (يعمل النظام بموافقة المدير)
enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// أنواع المستندات
enum DocumentType {
  ID_CARD
  PRACTICE_LICENSE
  EXPERIENCE_CERT
  OTHER
}

/// حالة مراجعة المستند
enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// حالة التكليف
enum AssignmentStatus {
  ACTIVE
  RECEIVED
  COMPLETED
  CANCELLED
}

/// حالة التكليف المُعلن (المنشور للتقديم)
enum PostStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
}

/// حالة التقديم على التكليف
enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// الجنس — للمستخدم ولشرط التكليف (أي جنس = لا قيد)
enum Gender {
  MALE
  FEMALE
  ANY
}

/// حالة الجهة الصحية
/// PENDING/REJECTED: جهات يقترحها الكادر أو المستلم الإداري ولا تُنشّط إلا باعتماد الإدارة
enum OrgStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
  REJECTED
}

/// نوع الجهة الصحية
enum OrgType {
  HOSPITAL
  MEDICAL_CENTER
  SPECIALIZED_CENTER
  CLINIC
  MEDICAL_COMPLEX
  OTHER
}

/// حالة الارتباط المهني للكادر مع الجهة الصحية
/// الحالات المحمية (ENDORSED/INTERVIEWED/UNENDORSED) لا يمكن للكادر تعيينها بنفسه
enum AffiliationStatus {
  WORKING      /// يعمل حالياً
  FORMER       /// عمل سابقاً
  INTERVIEWED  /// تمت مقابلته
  ENDORSED     /// معتمد
  PENDING      /// قيد المراجعة (طلب الكادر)
  EXTERNAL     /// خارجي مؤهل
  UNENDORSED   /// غير معتمد
  SUSPENDED    /// موقوف
}

/// طريقة توزيع التكليف المُعلن
enum DistributionMethod {
  ALL_MATCHING    /// نشر للجميع المطابقين (الافتراضي التاريخي)
  AUTO_MATCH      /// نشر تلقائي للمطابقين ذكاءً
  INVITE_SELECTED /// استدعاء ممرضين محددين
  FAVORITES       /// اختيار من المفضلة
  SAME_ORG        /// العاملون في نفس الجهة
  ENDORSED        /// المعتمدون
  INTERVIEWED     /// تمت مقابلتهم
  PROGRESSIVE     /// النشر التدريجي
}

/// حالة استدعاء كادر لتكليف محدد
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

/// حالة الدفع للإدارة
enum PaymentStatus {
  UNPAID
  PAID
}

/// حالة طلب سحب أرباح المستلم الإداري
enum WithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

/// أنواع الإشعارات
enum NotificationType {
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  DOCUMENT_UPLOADED
  DOCUMENT_REVIEWED
  ASSIGNMENT_CREATED
  ASSIGNMENT_RECEIVED
  ASSIGNMENT_COMPLETED
  ASSIGNMENT_CANCELLED
  POST_CREATED
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  INVITATION_EXPIRED
  AFFILIATION_UPDATED
  FAVORITE_ADDED
  GENERIC
}

// ---------- النماذج (Models) ----------

/// المستخدم: مدير النظام / الكادر التمريضي / المستلم الإداري
model User {
  id                String     @id @default(cuid())
  name              String
  phone             String     @unique
  password          String
  role              Role       @default(NURSE)
  status            UserStatus @default(PENDING)
  // حقول خاصة بالكادر التمريضي
  specialty         String?
  qualification     String?
  yearsOfExperience Int?
  gender            Gender?
  // ملاحظة الرفض في حال عدم اعتماد الحساب
  rejectNote        String?
  // الجهة الصحية (المستشفى) — يُدخلها المستلم الإداري عند التسجيل
  hospitalName      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  documents           Document[]
  assignments         Assignment[]   @relation("NurseAssignments")
  receivedAssignments Assignment[]   @relation("ReceiverAssignments")
  createdAssignments  Assignment[]   @relation("AssignmentCreator")
  notifications       Notification[]
  assignmentLogs      AssignmentLog[]
  documentsReviewed   Document[]     @relation("DocumentReviewer")
  posts               Post[]
  applications        Application[]
  applicationsReviewed Application[] @relation("ApplicationReviewer")
  // شبكة الكوادر: الارتباط المهني + المفضلة + الاستدعاءات
  affiliations          NurseAffiliation[] @relation("NurseAffiliations")
  affiliationsReviewed  NurseAffiliation[] @relation("AffiliationReviewer")
  affiliationRequests   NurseAffiliation[] @relation("AffiliationRequester")
  favoritesGiven        FavoriteNurse[]    @relation("ReceiverFavorites")
  favoritedBy           FavoriteNurse[]    @relation("NurseFavoritedBy")
  invitationsReceived   NurseInvitation[]  @relation("InvitedNurse")
  invitationsSent       NurseInvitation[]  @relation("InvitingReceiver")
  // حقول خاصة بالمستلم الإداري — بيانات السحب (تُحفظ بشكل رئيسي للسحب)
  walletAddress       String?
  accountNumber       String?
  ratingsReceived     NurseRating[]      @relation("RatingNurse")
  ratingsGiven        NurseRating[]      @relation("RatingReceiver")
  earnings            ReceiverEarning[]
  withdrawals         Withdrawal[]

  @@index([role, status])
  @@map("users")
}

/// مستندات الكادر التمريضي (يُحفظ رابط الملف فقط في قاعدة البيانات)
model Document {
  id           String          @id @default(cuid())
  userId       String
  type         DocumentType    @default(OTHER)
  title        String
  fileUrl      String
  fileName     String
  fileSize     Int?
  mimeType     String?
  status       DocumentStatus  @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("DocumentReviewer", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
  @@map("documents")
}

/// التكليف الطبي / التمريضي
model Assignment {
  id          String           @id @default(cuid())
  title       String
  description String?
  facility    String
  department  String?
  startDate   DateTime
  endDate     DateTime?
  status      AssignmentStatus @default(ACTIVE)
  nurseId     String
  receiverId  String
  createdById String
  receivedAt  DateTime?
  /// القيمة المالية للتكليف (بالريال اليمني) — تُعبأ تلقائياً من التكليف المُعلن
  value         Int?
  /// حصة الإدارة المحسوبة من قيمة التكليف
  adminFee      Int?
  /// حالة دفع الرسوم للإدارة
  paymentStatus PaymentStatus  @default(UNPAID)
  /// التكليف المُعلن الذي نتج عنه هذا التكليف (إن وجد)
  postId        String?
  // ---------- دورة الإنهاء والدفع ----------
  /// تأكيد الكادر من إنهاء التكليف واستلام مبلغ التكليف
  nurseDoneAt          DateTime?
  nurseConfirmedReceipt Boolean @default(false)
  /// إنهاء التكليف من جهة المستلم الإداري
  receiverDoneAt       DateTime?
  /// إجابة المستلم الإداري: هل تم الدفع للممرض؟
  nursePaid            Boolean?
  /// لقطة شاشة إثبات الدفع المرفوعة من الكادر (تظهر للإدارة بتكبير احترافي)
  paymentScreenshotUrl  String?
  paymentScreenshotName String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  nurse     User            @relation("NurseAssignments", fields: [nurseId], references: [id])
  receiver  User            @relation("ReceiverAssignments", fields: [receiverId], references: [id])
  createdBy User            @relation("AssignmentCreator", fields: [createdById], references: [id])
  post      Post?           @relation(fields: [postId], references: [id])
  logs      AssignmentLog[]
  rating    NurseRating?
  earning   ReceiverEarning?

  @@index([nurseId])
  @@index([receiverId])
  @@index([status])
  @@map("assignments")
}

/// محتوى الملفات المخزّنة داخل قاعدة البيانات (صور المستندات المضغوطة)
model FileBlob {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  @@map("file_blobs")
}

/// إعدادات المنصة (الرسوم وطرق الدفع) — مفتاح/قيمة
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// التكليف المُعلن من المستلم الإداري — يقدّم عليه الكادر التمريضي
model Post {
  id           String     @id @default(cuid())
  /// الرقم التسلسلي الاحترافي — يُستخدم في العنوان التلقائي «التكليف رقم N»
  number       Int        @default(0)
  title        String
  description  String?
  facility     String
  department   String?
  location     String?
  startDate    DateTime
  /// عدد الساعات المطلوبة للوردية/التكليف
  hours        Int?
  /// الجنس المطلوب للتكليف
  gender       Gender     @default(ANY)
  nursesNeeded Int        @default(1)
  /// قيمة التكليف (المقابل المالي الكامل) بالريال اليمني
  value        Int
  status       PostStatus @default(OPEN)
  receiverId   String
  /// الجهة الصحية المرتبطة (للمطابقة والارتباط المهني)
  hospitalId   String?
  /// طريقة توزيع التكليف — null يعني النشر العام للجميع (التوافق مع التكليفات السابقة)
  distribution        DistributionMethod?
  /// مرحلة النشر التدريجي الحالية (0 = المفضلون ... 3 = الخارجيون المؤهلون)
  progressiveStage    Int       @default(0)
  /// موعد الانتقال للمرحلة التالية في النشر التدريجي
  progressiveNextAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  receiver     User          @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  hospital     Hospital?     @relation(fields: [hospitalId], references: [id])
  applications Application[]
  assignments  Assignment[]
  invitations  NurseInvitation[]

  @@index([status])
  @@index([receiverId])
  @@map("posts")
}

/// الجهات الصحية (المستشفيات والمراكز الطبية) — كيانات مستقلة تُدار من الإدارة
/// وتُربط بها الكوادر التمريضية عبر الارتباط المهني وتُبنى عليها التكليفات
model Hospital {
  id        String   @id @default(cuid())
  name      String   @unique
  /// الموقع الفعلي للجهة — يُعبأ تلقائياً عند اختيار الجهة في التكليف
  location  String?
  /// الإحداثيات الجغرافية الحقيقية (تُلتقط من الخريطة التفاعلية)
  lat       Float?
  lng       Float?
  /// نوع الجهة: مستشفى / مركز طبي / مركز تخصصي / عيادة / مجمع طبي / أخرى
  type      OrgType  @default(HOSPITAL)
  city      String?
  address   String?
  phone     String?
  email     String?
  /// حالة الجهة: نشطة / غير نشطة / معلقة — الحقول المشتقة (isActive) للتوافق
  status    OrgStatus @default(ACTIVE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  affiliations NurseAffiliation[]
  posts        Post[]

  @@map("hospitals")
}

/// الأقسام الطبية — تُدار من حساب الإدارة (عناية، طوارئ، رقود، حضانة، قبالة، مختبر...)
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("departments")
}

/// تقديم الكادر التمريضي على تكليف مُعلن
model Application {
  id           String            @id @default(cuid())
  postId       String
  nurseId      String
  status       ApplicationStatus @default(PENDING)
  coverNote    String?
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  nurse     User       @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@unique([postId, nurseId])
  @@index([nurseId])
  @@index([postId])
  @@map("applications")
}

/// سجل أحداث التكليف
model AssignmentLog {
  id           String   @id @default(cuid())
  assignmentId String
  userId       String
  action       String
  note         String?
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@index([assignmentId])
  @@map("assignment_logs")
}

/// تقييم الكادر التمريضي من المستلم الإداري — احترافي ومتعدد المحاور
/// يظهر ضمن التقييمات في ملف الكادر ويُضاف إلى السيرة الذاتية عند التقديم لأي تكليف آخر
model NurseRating {
  id           String   @id @default(cuid())
  assignmentId String   @unique
  nurseId      String
  receiverId   String
  /// التقييم العام (1..5 نجوم)
  overall      Int
  /// الالتزام بالمواعيد (1..5)
  punctuality  Int?
  /// جودة الأداء الطبي (1..5)
  quality      Int?
  /// التعامل والتواصل (1..5)
  communication Int?
  /// الانضباط المهني (1..5)
  discipline   Int?
  comment      String?
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  nurse      User       @relation("RatingNurse", fields: [nurseId], references: [id], onDelete: Cascade)
  receiver   User       @relation("RatingReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([nurseId])
  @@index([receiverId])
  @@map("nurse_ratings")
}

/// أرباح المستلم الإداري — نسبة من كل تكليف تُحتسب من حساب الإدارة
model ReceiverEarning {
  id           String   @id @default(cuid())
  assignmentId String   @unique
  receiverId   String
  /// قيمة حصة المستلم الإداري من التكليف (ريال يمني)
  amount       Int
  /// النسبة المئوية لحظة الاحتساب (لقطة تاريخية)
  percent      Float
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  receiver   User       @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId])
  @@map("receiver_earnings")
}

/// طلب سحب أرباح المستلم الإداري — يظهر للإدارة بالمبلغ ورقم الحساب وعنوان المحفظة
model Withdrawal {
  id            String           @id @default(cuid())
  receiverId    String
  amount        Int
  walletAddress String
  accountNumber String
  status        WithdrawalStatus @default(PENDING)
  note          String?
  createdAt     DateTime @default(now())
  processedAt   DateTime?

  receiver User @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId])
  @@index([status])
  @@map("withdrawals")
}

/// الإشعارات داخل التطبيق
model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String?
  type      NotificationType @default(GENERIC)
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

/// الارتباط المهني — يربط الكادر التمريضي بجهة صحية مع تحديد طبيعة العلاقة
/// شبكة الكوادر الصحية المعتمدة | Verified Healthcare Workforce Network
model NurseAffiliation {
  id            String            @id @default(cuid())
  nurseId       String
  hospitalId    String
  status        AffiliationStatus @default(PENDING)
  /// الحالة التي طلبها مقدم الطلب (الكادر: يعمل حالياً/سابقاً) — الإدارة تعتمدها أو تعدّلها
  requestedStatus AffiliationStatus?
  /// سنوات العمل في الجهة — يُدخلها الكادر ضمن سيرته الذاتية
  workYears     Int?
  /// مَن أنشأ الارتباط (الكادر بطلب / المستلم / الإدارة)
  requestedById String?
  note          String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  nurse       User     @relation("NurseAffiliations", fields: [nurseId], references: [id], onDelete: Cascade)
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  requestedBy User?    @relation("AffiliationRequester", fields: [requestedById], references: [id])
  reviewedBy  User?    @relation("AffiliationReviewer", fields: [reviewedById], references: [id])

  @@unique([nurseId, hospitalId])
  @@index([nurseId])
  @@index([hospitalId])
  @@index([status])
  @@map("nurse_affiliations")
}

/// الممرضون المفضلون — قائمة خاصة بكل مستلم إداري لا تظهر لغيره
model FavoriteNurse {
  id         String   @id @default(cuid())
  receiverId String
  nurseId    String
  /// تصنيف اختياري ضمن المفضلة (مثال: عناية مركزة، طوارئ)
  category   String?
  note       String?
  createdAt  DateTime @default(now())

  receiver User @relation("ReceiverFavorites", fields: [receiverId], references: [id], onDelete: Cascade)
  nurse    User @relation("NurseFavoritedBy", fields: [nurseId], references: [id], onDelete: Cascade)

  @@unique([receiverId, nurseId])
  @@index([receiverId])
  @@index([nurseId])
  @@map("favorite_nurses")
}

/// استدعاء مباشر لكادر تمريضي لتكليف مُعلن — يحتوي قبول/رفض
model NurseInvitation {
  id          String           @id @default(cuid())
  postId      String
  nurseId     String
  receiverId  String
  status      InvitationStatus @default(PENDING)
  message     String?
  respondedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  nurse    User @relation("InvitedNurse", fields: [nurseId], references: [id], onDelete: Cascade)
  receiver User @relation("InvitingReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([postId, nurseId])
  @@index([nurseId])
  @@index([postId])
  @@index([receiverId])
  @@index([status])
  @@map("nurse_invitations")
}
