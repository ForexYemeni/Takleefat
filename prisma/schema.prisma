// ============================================================
// Takleefat | تكليفات — Prisma Schema (PostgreSQL)
// منصة إدارة التكليفات الطبية والتمريضية
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- التعدادات (Enums) ----------

/// أدوار المستخدمين
enum Role {
  ADMIN
  NURSE
  RECEIVER
}

/// حالة الحساب (يعمل النظام بموافقة المدير)
enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// أنواع المستندات
enum DocumentType {
  ID_CARD
  PRACTICE_LICENSE
  EXPERIENCE_CERT
  OTHER
}

/// حالة مراجعة المستند
enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// حالة التكليف
enum AssignmentStatus {
  ACTIVE
  RECEIVED
  COMPLETED
  CANCELLED
}

/// حالة التكليف المُعلن (المنشور للتقديم)
enum PostStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
}

/// حالة التقديم على التكليف
enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// حالة الدفع للإدارة
enum PaymentStatus {
  UNPAID
  PAID
}

/// أنواع الإشعارات
enum NotificationType {
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  DOCUMENT_UPLOADED
  DOCUMENT_REVIEWED
  ASSIGNMENT_CREATED
  ASSIGNMENT_RECEIVED
  ASSIGNMENT_COMPLETED
  ASSIGNMENT_CANCELLED
  POST_CREATED
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  GENERIC
}

// ---------- النماذج (Models) ----------

/// المستخدم: مدير النظام / الكادر التمريضي / المستلم الإداري
model User {
  id                String     @id @default(cuid())
  name              String
  phone             String     @unique
  password          String
  role              Role       @default(NURSE)
  status            UserStatus @default(PENDING)
  // حقول خاصة بالكادر التمريضي
  specialty         String?
  qualification     String?
  yearsOfExperience Int?
  // ملاحظة الرفض في حال عدم اعتماد الحساب
  rejectNote        String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  documents           Document[]
  assignments         Assignment[]   @relation("NurseAssignments")
  receivedAssignments Assignment[]   @relation("ReceiverAssignments")
  createdAssignments  Assignment[]   @relation("AssignmentCreator")
  notifications       Notification[]
  assignmentLogs      AssignmentLog[]
  documentsReviewed   Document[]     @relation("DocumentReviewer")
  posts               Post[]
  applications        Application[]
  applicationsReviewed Application[] @relation("ApplicationReviewer")

  @@index([role, status])
  @@map("users")
}

/// مستندات الكادر التمريضي (يُحفظ رابط الملف فقط في قاعدة البيانات)
model Document {
  id           String          @id @default(cuid())
  userId       String
  type         DocumentType    @default(OTHER)
  title        String
  fileUrl      String
  fileName     String
  fileSize     Int?
  mimeType     String?
  status       DocumentStatus  @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("DocumentReviewer", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
  @@map("documents")
}

/// التكليف الطبي / التمريضي
model Assignment {
  id          String           @id @default(cuid())
  title       String
  description String?
  facility    String
  department  String?
  startDate   DateTime
  endDate     DateTime?
  status      AssignmentStatus @default(ACTIVE)
  nurseId     String
  receiverId  String
  createdById String
  receivedAt  DateTime?
  /// القيمة المالية للتكليف (بالريال اليمني) — تُعبأ تلقائياً من التكليف المُعلن
  value         Int?
  /// حصة الإدارة المحسوبة من قيمة التكليف
  adminFee      Int?
  /// حالة دفع الرسوم للإدارة
  paymentStatus PaymentStatus  @default(UNPAID)
  /// التكليف المُعلن الذي نتج عنه هذا التكليف (إن وجد)
  postId        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  nurse     User            @relation("NurseAssignments", fields: [nurseId], references: [id])
  receiver  User            @relation("ReceiverAssignments", fields: [receiverId], references: [id])
  createdBy User            @relation("AssignmentCreator", fields: [createdById], references: [id])
  post      Post?           @relation(fields: [postId], references: [id])
  logs      AssignmentLog[]

  @@index([nurseId])
  @@index([receiverId])
  @@index([status])
  @@map("assignments")
}

/// محتوى الملفات المخزّنة داخل قاعدة البيانات (صور المستندات المضغوطة)
model FileBlob {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  @@map("file_blobs")
}

/// إعدادات المنصة (الرسوم وطرق الدفع) — مفتاح/قيمة
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// التكليف المُعلن من المستلم الإداري — يقدّم عليه الكادر التمريضي
model Post {
  id           String     @id @default(cuid())
  title        String
  description  String?
  facility     String
  department   String?
  location     String?
  startDate    DateTime
  endDate      DateTime?
  nursesNeeded Int        @default(1)
  /// قيمة التكليف (المقابل المالي الكامل) بالريال اليمني
  value        Int
  status       PostStatus @default(OPEN)
  receiverId   String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  receiver     User          @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  applications Application[]
  assignments  Assignment[]

  @@index([status])
  @@index([receiverId])
  @@map("posts")
}

/// تقديم الكادر التمريضي على تكليف مُعلن
model Application {
  id           String            @id @default(cuid())
  postId       String
  nurseId      String
  status       ApplicationStatus @default(PENDING)
  coverNote    String?
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  nurse     User       @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@unique([postId, nurseId])
  @@index([nurseId])
  @@index([postId])
  @@map("applications")
}

/// سجل أحداث التكليف
model AssignmentLog {
  id           String   @id @default(cuid())
  assignmentId String
  userId       String
  action       String
  note         String?
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@index([assignmentId])
  @@map("assignment_logs")
}

/// الإشعارات داخل التطبيق
model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String?
  type      NotificationType @default(GENERIC)
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}
