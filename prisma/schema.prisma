// ============================================================
// Takleefat | تكليفات — Prisma Schema (PostgreSQL)
// منصة إدارة التكليفات الطبية والتمريضية
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- التعدادات (Enums) ----------

/// أدوار المستخدمين
/// الجولة 66 — ميزة «فرصة»: دور الموارد البشرية (HR) — إضافي بحت:
/// لا يوجد تسجيل ذاتي إطلاقاً — الإدارة وحدها تنشئ حسابات HR من لوحتها،
/// والحسابات القائمة بخمسة أدوار تعمل كما هي دون أي تغيير.
enum Role {
  ADMIN
  NURSE
  RECEIVER
  DOCTOR
  DOCTOR_SUPERVISOR
  HR
}

/// جمهور التكليف المُعلن — الكادر المستهدف بالتقديم
/// NURSE: كادر تمريضي (السلوك التاريخي) | DOCTOR: أطباء (منظومة الأطباء)
enum Audience {
  NURSE
  DOCTOR
}

/// حالة الحساب (يعمل النظام بموافقة المدير)
enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// أنواع المستندات
enum DocumentType {
  ID_CARD
  PRACTICE_LICENSE
  EXPERIENCE_CERT
  OTHER
}

/// حالة مراجعة المستند
enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// حالة التكليف
enum AssignmentStatus {
  ACTIVE
  RECEIVED
  COMPLETED
  CANCELLED
}

/// حالة التكليف المُعلن (المنشور للتقديم)
enum PostStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
}

/// حالة التقديم على التكليف
enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// الجنس — للمستخدم ولشرط التكليف (أي جنس = لا قيد)
enum Gender {
  MALE
  FEMALE
  ANY
}

/// حالة الجهة الصحية
/// PENDING/REJECTED: جهات يقترحها الكادر أو المستلم الإداري ولا تُنشّط إلا باعتماد الإدارة
enum OrgStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
  REJECTED
}

/// نوع الجهة الصحية
enum OrgType {
  HOSPITAL
  MEDICAL_CENTER
  SPECIALIZED_CENTER
  CLINIC
  MEDICAL_COMPLEX
  OTHER
}

/// حالة الارتباط المهني للكادر مع الجهة الصحية
/// الحالات المحمية (ENDORSED/INTERVIEWED/UNENDORSED) لا يمكن للكادر تعيينها بنفسه
enum AffiliationStatus {
  WORKING /// يعمل حالياً
  FORMER /// عمل سابقاً
  INTERVIEWED /// تمت مقابلته
  ENDORSED /// معتمد
  ON_CALL /// تحت الإستدعاء — ضمن كوادر الجهة وجاهز للاستدعاء عند الحاجة
  PENDING /// قيد المراجعة (طلب الكادر)
  EXTERNAL /// خارجي مؤهل
  UNENDORSED /// غير معتمد
  SUSPENDED /// موقوف
}

/// طريقة توزيع التكليف المُعلن
enum DistributionMethod {
  ALL_MATCHING /// نشر للجميع المطابقين (الافتراضي التاريخي)
  AUTO_MATCH /// نشر تلقائي للمطابقين ذكاءً
  INVITE_SELECTED /// استدعاء ممرضين محددين
  FAVORITES /// اختيار من المفضلة
  SAME_ORG /// العاملون في نفس الجهة
  ENDORSED /// المعتمدون
  INTERVIEWED /// تمت مقابلتهم
  PROGRESSIVE /// النشر التدريجي
}

/// حالة استدعاء كادر لتكليف محدد
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

/// حالة الدفع للإدارة
enum PaymentStatus {
  UNPAID
  PAID
}

/// حالة طلب سحب أرباح المستلم الإداري
enum WithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

/// حالة ربط مسؤول (مستلم إداري / مشرف أطباء) بجهة صحية — الجولة 44:
/// يضيف المسؤول جهة صحية أخرى لملفه فتُعرض للإدارة لاعتمادها أو رفضها
enum ReceiverOrgStatus {
  PENDING
  ACTIVE
  REJECTED
}

/// أنواع الإشعارات
enum NotificationType {
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  DOCUMENT_UPLOADED
  DOCUMENT_REVIEWED
  ASSIGNMENT_CREATED
  ASSIGNMENT_RECEIVED
  ASSIGNMENT_STARTED
  ASSIGNMENT_COMPLETED
  ASSIGNMENT_CANCELLED
  POST_CREATED
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  INVITATION_EXPIRED
  AFFILIATION_UPDATED
  FAVORITE_ADDED
  // ---------- الجولة 61: خصوصية المستندات (إضافي بحت — قيم جديدة فقط) ----------
  DOCUMENT_ACCESS_REQUESTED
  DOCUMENT_ACCESS_DECIDED
  DOCUMENT_ACCESS_GRANTED
  DOCUMENT_ACCESS_REVOKED
  // ---------- الجولة 63: سجل التواصل الإداري عبر واتساب (إضافي بحت — قيمة جديدة فقط) ----------
  /// تسجيل رسالة واتساب أرسلتها الإدارة لكادر من شاشة الكادر التمريضي —
  /// يظهر للكادر إشعاراً داخلياً وللإدارة في «سجل التواصل» بملف الكادر.
  ADMIN_WHATSAPP
  GENERIC
  // ---------- الجولة 66: ميزة «فرصة | Forsah» (إضافي بحت — قيم جديدة فقط) ----------
  /// أحداث دورة حياة الفرصة — تُستخدم عبر notify()/notifyAdmins() القائمة دون أي نظام إشعارات جديد
  OPPORTUNITY_PUBLISHED
  OPPORTUNITY_APPLICATION_RECEIVED
  OPPORTUNITY_APPLICATION_REVIEWED
  OPPORTUNITY_INTERVIEW_INVITED
  OPPORTUNITY_INTERVIEW_CONFIRMED
  OPPORTUNITY_INTERVIEW_DECLINED
  OPPORTUNITY_CANDIDATE_SELECTED
  OPPORTUNITY_PAYMENT_PENDING
  OPPORTUNITY_PAYMENT_COMPLETED
  /// الجولة 70 — اختار المرشح توقيت سداد رسوم الخدمة
  OPPORTUNITY_PAYMENT_TIMING_SELECTED
  /// الجولة 71 — رفع المرشح إثبات دفع رسوم الخدمة
  OPPORTUNITY_PAYMENT_PROOF_SUBMITTED
  /// الجولة 71 — أكدت الإدارة وصول دفعة رسوم الخدمة
  OPPORTUNITY_PAYMENT_CONFIRMED
  /// الجولة 71 — رفضت الإدارة إثبات دفع رسوم الخدمة
  OPPORTUNITY_PAYMENT_PROOF_REJECTED
  OPPORTUNITY_CLOSED
}

// ---------- النماذج (Models) ----------

/// المستخدم: مدير النظام / الكادر التمريضي / المستلم الإداري
model User {
  id                String     @id @default(cuid())
  name              String
  phone             String     @unique
  password          String
  role              Role       @default(NURSE)
  status            UserStatus @default(PENDING)
  // حقول خاصة بالكادر التمريضي
  specialty         String?
  qualification     String?
  yearsOfExperience Int?
  gender            Gender?
  // ملاحظة الرفض في حال عدم اعتماد الحساب
  rejectNote        String?
  // نِسَب الحصة من قيمة كل تكليف (٪) — للمستلم الإداري ومشرف الأطباء فقط.
  // null = تلقائي: نصف نسبة الإدارة (adminPercentage / 2) — والإدارة قد تخصّصها لكل حساب (0..100)
  commissionPercent Float?
  // إذن رؤية البيانات الكاملة (السيرة الذاتية + المستندات + كل البيانات) للكادر/الأطباء —
  // يُفتح من حساب الإدارة حصراً لبعض المستلمين الإداريين ومشرفي الأطباء
  fullProfileAccess Boolean    @default(false)
  // «موثوق جداً» — الجولة 36: إذن رؤية بيانات الاتصال (أرقام الهواتف) لأي كادر تمريضي
  // أو طبيب في أي وقت — حتى بعد إنهاء التكليفات — يُمنح من حساب الإدارة حصراً
  trustedContactViewer Boolean @default(false)
  // ---------- الجولة 60: الصلاحيات المركّبة — إضافي بحت ولا يمس أي بيانات سابقة ----------
  /// أدوار إضافية ممنوحة فوق الدور الأساسي (role يبقى الدور الأساسي دون أي تغيير):
  /// مثال: مستلم إداري (RECEIVER) + صلاحية DOCTOR_SUPERVISOR → يدخل اللوحتين.
  /// قيم مسموحة: NURSE | RECEIVER | DOCTOR | DOCTOR_SUPERVISOR — ADMIN مستثنى نهائياً.
  /// فارغة [] = حساب عادي بدور واحد كما كان — كل الحسابات القائمة تعمل كما هي بلا أي تغيير.
  extraRoles           String[] @default([])
  /// الوضع النشط الحالي للعمل (أي لوحة يستخدم الآن) — null = الدور الأساسي.
  /// يُثبَّت تلقائياً عند دخول أي لوحة يملك صلاحيتها (أساسية أو مركّبة) ويتحقق
  /// في كل جلسة: إن لم يعد ضمن الصلاحيات الفعالة يُتجاهل ويعود للدور الأساسي (تراجع آمن).
  activeRole           String?
  // ---------- الجولة 61: صورة البروفايل (الأيقونة) — إضافي بحت ولا يمس أي بيانات سابقة ----------
  /// صورة أيقونة يختارها الكادر من ملفه الشخصي — تظهر للمستلمين الإداريين
  /// ومشرفي الأطباء والإدارة وفي البطاقة المهنية العامة والتقديمات.
  /// null = بلا صورة (تظهر الصورة الرمزية بالحرف الأول كما كان تماماً).
  /// إجبارية للكادر الذكور (NURSE/DOCTOR + gender MALE) واختيارية للإناث —
  /// يُفرض ذلك في الواجهات ومسار الرفع دون أي مساس بالبيانات القائمة.
  profilePhotoBlobId String?
  /// الجولة 61: طلبات رؤية المستندات — يطلبها المستلم/المشرف بسبب معلن وتقررها الإدارة وتسحبها متى شاءت
  documentAccessRequested DocumentAccessRequest[] @relation("DocAccessRequester")
  documentAccessReceived  DocumentAccessRequest[] @relation("DocAccessTarget")
  documentAccessReviewed  DocumentAccessRequest[] @relation("DocAccessReviewer")
  // ---------- الجولة 66: ميزة «فرصة» — حقول HR (إضافي بحت، كلها nullable/افتراضية) ----------
  /// المسمى الوظيفي — لحسابات الموارد البشرية (مثال: مدير التوظيف) — null لبقية الأدوار
  jobTitle String?
  /// صلاحيات «فرصة» الممنوحة للحساب (مفاتيح opportunity.*) — فارغة = بلا صلاحيات فرصة
  /// الإدارة تملك كل الصلاحيات دائماً بغض النظر عن هذه القائمة
  forsahPermissions String[] @default([])
  /// نسبة عمولة HR من رسوم الفرصة (٪) — تتجاوز الإعداد العام إن عُينت — null = الإعداد العام
  forsahCommissionPercent Float?
  // الجهة الصحية (المستشفى) — يُدخلها المستلم الإداري عند التسجيل
  hospitalName      String?
  // الجولة 44: الجهات الصحية المرتبطة بالمسؤول (المستلم/المشرف) — الجهة
  // الأساسية من hospitalName، والإضافية تُطلب من ملفه وتُعتمد من الإدارة
  orgLinks          ReceiverOrgLink[] @relation("ReceiverOrgLinks")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  documents            Document[]
  assignments          Assignment[]       @relation("NurseAssignments")
  receivedAssignments  Assignment[]       @relation("ReceiverAssignments")
  createdAssignments   Assignment[]       @relation("AssignmentCreator")
  notifications        Notification[]
  // ---------- الجولة 55: الإشعارات الأصلية لتطبيق أندرويد ----------
  // أجهزة الهاتف المرتبطة بالحساب لاستقبال تنبيهات أصلية حتى مع إغلاق التطبيق
  deviceRegistrations  DeviceRegistration[]
  assignmentLogs       AssignmentLog[]
  documentsReviewed    Document[]         @relation("DocumentReviewer")
  posts                Post[]
  applications         Application[]
  applicationsReviewed Application[]      @relation("ApplicationReviewer")
  // أقسام العمل التي يعمل بها الكادر (رقود/طوارئ/عناية/مختبر...) — تعدد أقسام من كتالوج الإدارة
  workDepartments      WorkDepartment[]   @relation("NurseWorkDepartments")
  // ---------- الجولة 51: البريد الإلكتروني — قناة إشعارات رسمية إضافية ----------
  // الدخول يبقى هاتف + كلمة مرور حصراً — البريد للإشعارات والتنبيهات والأمان فقط
  email                     String?
  emailVerified             Boolean   @default(false)
  /// رمز التحقق من 6 أرقام — يُخزن مؤقتاً حتى التأكيد ولا يُعاد أبداً في أي استجابة برمجية
  emailVerificationCode     String?
  /// صلاحية رمز التحقق — افتراضياً 15 دقيقة من الإرسال
  emailVerificationExpires  DateTime?
  /// آخر وقت إرسال رمز — للحد من طلب الرموز المتكرر (60 ثانية بين الطلبات)
  emailVerificationSentAt   DateTime?
  /// المفتاح الرئيس لإشعارات البريد — يُفعّل تلقائياً عند تأكيد البريد
  emailNotificationEnabled  Boolean   @default(true)
  /// تفضيلات أقسام الإشعارات JSON: {assignments,requests,updates,documents,admin,account,important}
  /// أقسام الأمان (security) مقفلة دائماً ولا تُخزن هنا
  emailPreferences          String?
  // تخصصات عمل الطبيب — تعدد تخصصات من كتالوج التخصصات الطبية (منظومة الأطباء)
  workSpecialties      DoctorSpecialty[]  @relation("DoctorWorkSpecialties")
  // شبكة الكوادر: الارتباط المهني + المفضلة + الاستدعاءات
  affiliations         NurseAffiliation[] @relation("NurseAffiliations")
  affiliationsReviewed NurseAffiliation[] @relation("AffiliationReviewer")
  affiliationRequests  NurseAffiliation[] @relation("AffiliationRequester")
  favoritesGiven       FavoriteNurse[]    @relation("ReceiverFavorites")
  favoritedBy          FavoriteNurse[]    @relation("NurseFavoritedBy")
  invitationsReceived  NurseInvitation[]  @relation("InvitedNurse")
  invitationsSent      NurseInvitation[]  @relation("InvitingReceiver")
  // حقول خاصة بالمستلم الإداري — بيانات السحب (تُحفظ بشكل رئيسي للسحب)
  walletAddress        String?
  accountNumber        String?
  ratingsReceived      NurseRating[]      @relation("RatingNurse")
  ratingsGiven         NurseRating[]      @relation("RatingReceiver")
  earnings             ReceiverEarning[]
  withdrawals          Withdrawal[]
  pushSubscriptions    PushSubscription[]
  // ---------- الجولة 66: ميزة «فرصة» — علاقات المستخدم (إضافي بحت) ----------
  /// الفرص التي أنشأها حساب HR
  forsahOpportunitiesCreated Opportunity[]             @relation("OpportunityCreator")
  /// تقديمات المستخدم على فرص العمل الصحية
  forsahApplications         OpportunityApplication[]
  /// دعوات المقابلة التي أنشأها (HR/الإدارة)
  forsahInterviewsCreated    OpportunityInterview[]    @relation("OpportunityInterviewCreator")
  /// دعوات المقابلة الموجهة له كمرشح
  forsahInterviewsReceived   OpportunityInterview[]    @relation("OpportunityInterviewCandidate")
  /// اختيارات الموظفين التي أجراها (HR/الإدارة)
  forsahSelectionsCreated    OpportunitySelection[]    @relation("OpportunitySelectionCreator")
  /// الاختيارات الموجهة له كمرشح
  forsahSelectionsReceived   OpportunitySelection[]    @relation("OpportunitySelectionCandidate")
  /// سجلات التدقيق التي نفّذها
  forsahAuditLogs            OpportunityAuditLog[]     @relation("ForsahAuditActor")
  /// مشاهدات الملفات المهنية التي أجراها (خصوصية فرصة)
  forsahViewLogs             OpportunityViewLog[]      @relation("ForsahViewViewer")

  @@index([role, status])
  @@map("users")
}

/// مستندات الكادر التمريضي (يُحفظ رابط الملف فقط في قاعدة البيانات)
model Document {
  id           String         @id @default(cuid())
  userId       String
  type         DocumentType   @default(OTHER)
  title        String
  fileUrl      String
  fileName     String
  fileSize     Int?
  mimeType     String?
  status       DocumentStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("DocumentReviewer", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
  @@map("documents")
}

/// التكليف الطبي / التمريضي
model Assignment {
  id                    String           @id @default(cuid())
  title                 String
  description           String?
  facility              String
  department            String?
  startDate             DateTime
  endDate               DateTime?
  status                AssignmentStatus @default(ACTIVE)
  nurseId               String
  receiverId            String
  createdById           String
  receivedAt            DateTime?
  /// القيمة المالية للتكليف (بالريال اليمني) — تُعبأ تلقائياً من التكليف المُعلن
  value                 Int?
  /// حصة الإدارة المحسوبة من قيمة التكليف
  adminFee              Int?
  /// حالة دفع الرسوم للإدارة
  paymentStatus         PaymentStatus    @default(UNPAID)
  /// التكليف المُعلن الذي نتج عنه هذا التكليف (إن وجد)
  postId                String?
  // ---------- دورة الإنهاء والدفع ----------
  /// تأكيد الكادر من إنهاء التكليف واستلام مبلغ التكليف
  nurseDoneAt           DateTime?
  nurseConfirmedReceipt Boolean          @default(false)
  /// إنهاء التكليف من جهة المستلم الإداري
  receiverDoneAt        DateTime?
  /// إجابة المستلم الإداري: هل تم الدفع للممرض؟
  nursePaid             Boolean?
  /// الجولة 46: سبب الإنهاء المبكر من المستلم الإداري أو مشرف الأطباء —
  /// إلزامي عند الإنهاء قبل اكتمال وقت التكليف (البلاغ الحرفي:
  /// «المستلم الاداري او مشرف الاطباء يتمكن من انهاء التكليف قبل اكتماله مع ذكر السبب»)
  earlyEndReason        String?
  /// الجولة 44: متى أُرسل إشعار بداية التكليف للطرفين — يُرسل مرة واحدة عند بلوغ وقت البدء
  startNotifiedAt       DateTime?
  /// لقطة شاشة إثبات الدفع المرفوعة من الكادر (تظهر للإدارة بتكبير احترافي)
  paymentScreenshotUrl  String?
  paymentScreenshotName String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  nurse     User             @relation("NurseAssignments", fields: [nurseId], references: [id])
  receiver  User             @relation("ReceiverAssignments", fields: [receiverId], references: [id])
  createdBy User             @relation("AssignmentCreator", fields: [createdById], references: [id])
  post      Post?            @relation(fields: [postId], references: [id])
  logs      AssignmentLog[]
  rating    NurseRating?
  earning   ReceiverEarning?

  @@index([nurseId])
  @@index([receiverId])
  @@index([status])
  @@map("assignments")
}

/// محتوى الملفات المخزّنة داخل قاعدة البيانات (صور المستندات المضغوطة)
model FileBlob {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  @@map("file_blobs")
}

/// إعدادات المنصة (الرسوم وطرق الدفع) — مفتاح/قيمة
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// التكليف المُعلن من المستلم الإداري — يقدّم عليه الكادر التمريضي
model Post {
  id                String              @id @default(cuid())
  /// الرقم التسلسلي الاحترافي — يُستخدم في العنوان التلقائي «التكليف رقم N»
  number            Int                 @default(0)
  title             String
  description       String?
  facility          String
  department        String?
  location          String?
  startDate         DateTime
  /// عدد الساعات المطلوبة للوردية/التكليف
  hours             Int?
  /// وقت انتهاء المناوبة المحسوب (من وقت البدء + الساعات) — بتوقيت مكة المكرمة (UTC+3)
  /// الجولة 44: للعداد التنازلي الحي في كل الحسابات
  endTime           DateTime?
  /// الجنس المطلوب للتكليف
  gender            Gender              @default(ANY)
  /// جمهور التكليف — NURSE: يقدّم عليه الكادر التمريضي | DOCTOR: يقدّم عليه الأطباء
  audience          Audience            @default(NURSE)
  nursesNeeded      Int                 @default(1)
  /// قيمة التكليف (المقابل المالي الكامل) بالريال اليمني
  value             Int
  status            PostStatus          @default(OPEN)
  receiverId        String
  /// الجهة الصحية المرتبطة (للمطابقة والارتباط المهني)
  hospitalId        String?
  /// طريقة توزيع التكليف — null يعني النشر العام للجميع (التوافق مع التكليفات السابقة)
  distribution      DistributionMethod?
  /// مرحلة النشر التدريجي الحالية (0 = المفضلون ... 3 = الخارجيون المؤهلون)
  progressiveStage  Int                 @default(0)
  /// موعد الانتقال للمرحلة التالية في النشر التدريجي
  progressiveNextAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  receiver     User              @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  hospital     Hospital?         @relation(fields: [hospitalId], references: [id])
  applications Application[]
  assignments  Assignment[]
  invitations  NurseInvitation[]

  @@index([status])
  @@index([receiverId])
  @@map("posts")
}

/// الجهات الصحية (المستشفيات والمراكز الطبية) — كيانات مستقلة تُدار من الإدارة
/// وتُربط بها الكوادر التمريضية عبر الارتباط المهني وتُبنى عليها التكليفات
model Hospital {
  id        String    @id @default(cuid())
  name      String    @unique
  /// الموقع الفعلي للجهة — يُعبأ تلقائياً عند اختيار الجهة في التكليف
  location  String?
  /// الإحداثيات الجغرافية الحقيقية (تُلتقط من الخريطة التفاعلية)
  lat       Float?
  lng       Float?
  /// نوع الجهة: مستشفى / مركز طبي / مركز تخصصي / عيادة / مجمع طبي / أخرى
  type      OrgType   @default(HOSPITAL)
  city      String?
  address   String?
  phone     String?
  email     String?
  /// حالة الجهة: نشطة / غير نشطة / معلقة — الحقول المشتقة (isActive) للتوافق
  status    OrgStatus @default(ACTIVE)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  affiliations NurseAffiliation[]
  posts        Post[]
  orgLinks     ReceiverOrgLink[] @relation("ReceiverOrgHospitals")
  // الجولة 66: فرص العمل الصحية المرتبطة بالجهة (ميزة «فرصة» — إضافي بحت)
  forsahOpportunities Opportunity[]

  @@map("hospitals")
}

/// ربط الجهات الصحية بمسؤوليها (المستلم الإداري / مشرف الأطباء) — الجولة 44:
/// «في حساب المستلم الإداري الملف الشخصي يجب ان تظهر الجهه الصحية التي يعمل
/// فيها ويمكنه اضافه جهه صحية اخرى بشرط الموافقة عليها من حساب الادارة»
model ReceiverOrgLink {
  id           String            @id @default(cuid())
  receiverId   String
  hospitalId   String
  status       ReceiverOrgStatus @default(PENDING)
  /// ملاحظة طلب اختيارية من المسؤول
  note         String?
  createdAt    DateTime          @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  receiver User     @relation("ReceiverOrgLinks", fields: [receiverId], references: [id], onDelete: Cascade)
  hospital Hospital @relation("ReceiverOrgHospitals", fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([receiverId, hospitalId])
  @@index([receiverId])
  @@index([hospitalId, status])
  @@map("receiver_org_links")
}

/// الأقسام الطبية — تُدار من حساب الإدارة (عناية، طوارئ، رقود، حضانة، قبالة، مختبر...)
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  nurses WorkDepartment[] @relation("DepartmentNurses")
  // الجولة 66: الفرص المطلوب بها هذا القسم (ميزة «فرصة» — إضافي بحت)
  forsahOpportunities Opportunity[]

  @@map("departments")
}

/// أقسام عمل الكادر التمريضي — يختار الكادر عدة أقسام يعمل بها من كتالوج الإدارة
/// (ممرض رقود، ممرض طوارئ، ممرض عناية، ممرض مختبر...) وعند إنشاء تكليف في قسم
/// محدد يصل التكليف مباشرة لمن أضاف هذا القسم ضمن أقسام عمله
model WorkDepartment {
  id           String   @id @default(cuid())
  nurseId      String
  departmentId String
  createdAt    DateTime @default(now())

  nurse      User       @relation("NurseWorkDepartments", fields: [nurseId], references: [id], onDelete: Cascade)
  department Department @relation("DepartmentNurses", fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([nurseId, departmentId])
  @@index([departmentId])
  @@map("work_departments")
}

/// التخصصات الطبية — كتالوج مستقل تُديره الإدارة (باطنية، جراحة عامة، أطفال، نساء وولادة...)
/// تُختار عند إنشاء تكليف مُوجّه للأطباء ويصرح بها الطبيب ضمن تخصصات عمله
model Specialty {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  doctors DoctorSpecialty[] @relation("SpecialtyDoctors")
  // الجولة 66: الفرص المطلوب بها هذا التخصص (ميزة «فرصة» — إضافي بحت)
  forsahOpportunities Opportunity[]

  @@map("specialties")
}

/// المؤهلات العلمية — كتالوج مستقل تُديره الإدارة (الجولة 32)
/// يُغذّى تلقائياً بالخيارات التاريخية عند أول استخدام ويمكن للإدارة إضافة مؤهلات جديدة
/// أو تعديل أسمائها أو تعطيلها — وتُختار منه مؤهلات الكادر التمريضي والأطباء في كل النماذج
model Qualification {
  id        String   @id @default(cuid())
  name      String   @unique
  /// جمهور المؤهل: NURSE = كادر تمريضي | DOCTOR = أطباء
  audience  Audience
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // الجولة 66: الفرص المطلوب بها هذا المؤهل (ميزة «فرصة» — إضافي بحت)
  forsahOpportunities Opportunity[]

  @@map("qualifications")
}

/// تخصصات عمل الطبيب — يختار الطبيب عدة تخصصات يعمل بها من كتالوج الإدارة
/// وعند إنشاء تكليف أطباء بتخصص محدد يصل التكليف مباشرة لمن أضاف هذا التخصص
model DoctorSpecialty {
  id          String   @id @default(cuid())
  doctorId    String
  specialtyId String
  createdAt   DateTime @default(now())

  doctor    User      @relation("DoctorWorkSpecialties", fields: [doctorId], references: [id], onDelete: Cascade)
  specialty Specialty @relation("SpecialtyDoctors", fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([doctorId, specialtyId])
  @@index([specialtyId])
  @@map("doctor_specialties")
}

/// تقديم الكادر التمريضي على تكليف مُعلن
model Application {
  id           String            @id @default(cuid())
  postId       String
  nurseId      String
  status       ApplicationStatus @default(PENDING)
  coverNote    String?
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  post       Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  nurse      User  @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@unique([postId, nurseId])
  @@index([nurseId])
  @@index([postId])
  @@map("applications")
}

/// سجل أحداث التكليف
model AssignmentLog {
  id           String   @id @default(cuid())
  assignmentId String
  userId       String
  action       String
  note         String?
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@index([assignmentId])
  @@map("assignment_logs")
}

/// تقييم الكادر التمريضي من المستلم الإداري — احترافي ومتعدد المحاور
/// يظهر ضمن التقييمات في ملف الكادر ويُضاف إلى السيرة الذاتية عند التقديم لأي تكليف آخر
model NurseRating {
  id            String   @id @default(cuid())
  assignmentId  String   @unique
  nurseId       String
  receiverId    String
  /// التقييم العام (1..5 نجوم)
  overall       Int
  /// الالتزام بالمواعيد (1..5)
  punctuality   Int?
  /// جودة الأداء الطبي (1..5)
  quality       Int?
  /// التعامل والتواصل (1..5)
  communication Int?
  /// الانضباط المهني (1..5)
  discipline    Int?
  comment       String?
  createdAt     DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  nurse      User       @relation("RatingNurse", fields: [nurseId], references: [id], onDelete: Cascade)
  receiver   User       @relation("RatingReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([nurseId])
  @@index([receiverId])
  @@map("nurse_ratings")
}

/// أرباح المستلم الإداري — نسبة من كل تكليف تُحتسب من حساب الإدارة
model ReceiverEarning {
  id           String   @id @default(cuid())
  assignmentId String   @unique
  receiverId   String
  /// قيمة حصة المستلم الإداري من التكليف (ريال يمني)
  amount       Int
  /// النسبة المئوية لحظة الاحتساب (لقطة تاريخية)
  percent      Float
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  receiver   User       @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId])
  @@map("receiver_earnings")
}

/// طلب سحب أرباح المستلم الإداري — يظهر للإدارة بالمبلغ ورقم الحساب وعنوان المحفظة
model Withdrawal {
  id            String           @id @default(cuid())
  receiverId    String
  amount        Int
  walletAddress String
  accountNumber String
  status        WithdrawalStatus @default(PENDING)
  note          String?
  createdAt     DateTime         @default(now())
  processedAt   DateTime?

  receiver User @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId])
  @@index([status])
  @@map("withdrawals")
}

/// الإشعارات داخل التطبيق
model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String?
  type      NotificationType @default(GENERIC)
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

/// سجل إرسال البريد الإلكتروني — الجولة 51
/// كل محاولة إرسال حقيقية تُسجَّل هنا (pending → sent/failed) لعرضها للإدارة
/// وإعادة الإرسال عند الحاجة — الفشل لا يؤثر أبداً على العملية الأساسية
model EmailLog {
  id               String    @id @default(cuid())
  /// معرف المستلم الداخلي — null للإرسال الإداري المباشر لعنوان خارجي
  recipientUserId  String?
  recipientEmail   String
  /// نوع الإشعار (EMAIL_VERIFICATION / POST_CREATED / TEST / ...)
  notificationType String
  subject          String
  /// pending أثناء المحاولة / sent نجح / failed فشل
  status           String    @default("pending")
  errorMessage     String?
  /// معرف الكيان المرتبط (تكليف/تقديم/مستند...) إن وجد
  relatedEntityId  String?
  /// مفتاح منع التكرار — فريد على مستوى القاعدة يمنع الإرسال المزدوج نهائياً
  idempotencyKey   String    @unique
  /// حمولة الإرسال الكاملة (JSON نصي) لإعادة الإرسال الأمينة من الإدارة
  payloadJson      String?
  sentAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}

/// اشتراكات الإشعارات الفورية (Web Push)
/// الجولة العشرون: نفس الجهاز قد يخدم عدة حسابات — لكل حساب صف مستقل بنفس الـ endpoint،
/// فيصل الإشعار لصاحبه مهما كان الحساب النشط حالياً على الجهاز
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  /// رابط نقطة نهاية خدمة الدفع الفوري (endpoint من المتصفح) — قد يتشاركه عدة حسابات لنفس الجهاز
  endpoint  String
  /// مفاتيح التشفير من المتصفح (p256dh + auth) — لا تُقرأ إلا لخدمة الدفع
  p256dh    String
  auth      String
  /// معرّف المتصفح/الجهاز لعرضه للإدارة وحذف القديم
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

/// تسجيلات أجهزة أندرويد الأصلية — الجولة 55
/// يربط جهاز الهاتف (تطبيق APK الأصلي) بحساب المستخدم لاستقبال إشعارات
/// أصلية من التطبيق نفسه (بلا وسيط متصفح) عبر خدمة التنبيهات الأمامية
/// التي تعمل حتى لو كان التطبيق مغلق تماماً — إضافي بحت ولا يمس أي نظام قائم
model DeviceRegistration {
  id       String @id @default(cuid())
  /// معرف الجهاز الفريد — UUID يولّده التطبيق ويخزنه محلياً
  deviceId String @unique
  /// سر التحقق الخاص بالجهاز — يُنشأ على الجهاز ويُطابق عند كل استعلام
  secret   String
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// موديل الجهاز (للتشخيص والإحصاء)
  model      String?
  /// إصدار تطبيق أندرويد المثبت
  appVersion String?
  platform   String  @default("android")
  /// مؤشر التسليم — لا تُسلّم الإشعارات الأقدم منه (يُدار من مسار poll)
  lastDeliveredAt DateTime @default(now())
  /// غير مفعّل عند تسجيل الخروج أو فصل الجهاز
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_registrations")
}

/// الارتباط المهني — يربط الكادر التمريضي بجهة صحية مع تحديد طبيعة العلاقة
/// شبكة الكوادر الصحية المعتمدة | Verified Healthcare Workforce Network
model NurseAffiliation {
  id              String             @id @default(cuid())
  nurseId         String
  hospitalId      String
  status          AffiliationStatus  @default(PENDING)
  /// الحالة التي طلبها مقدم الطلب (الكادر: يعمل حالياً/سابقاً) — الإدارة تعتمدها أو تعدّلها
  requestedStatus AffiliationStatus?
  /// سنوات العمل في الجهة — يُدخلها الكادر ضمن سيرته الذاتية
  workYears       Int?
  /// مَن أنشأ الارتباط (الكادر بطلب / المستلم / الإدارة)
  requestedById   String?
  note            String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  nurse       User     @relation("NurseAffiliations", fields: [nurseId], references: [id], onDelete: Cascade)
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  requestedBy User?    @relation("AffiliationRequester", fields: [requestedById], references: [id])
  reviewedBy  User?    @relation("AffiliationReviewer", fields: [reviewedById], references: [id])

  @@unique([nurseId, hospitalId])
  @@index([nurseId])
  @@index([hospitalId])
  @@index([status])
  @@map("nurse_affiliations")
}

/// الممرضون المفضلون — قائمة خاصة بكل مستلم إداري لا تظهر لغيره
model FavoriteNurse {
  id         String   @id @default(cuid())
  receiverId String
  nurseId    String
  /// تصنيف اختياري ضمن المفضلة (مثال: عناية مركزة، طوارئ)
  category   String?
  note       String?
  createdAt  DateTime @default(now())

  receiver User @relation("ReceiverFavorites", fields: [receiverId], references: [id], onDelete: Cascade)
  nurse    User @relation("NurseFavoritedBy", fields: [nurseId], references: [id], onDelete: Cascade)

  @@unique([receiverId, nurseId])
  @@index([receiverId])
  @@index([nurseId])
  @@map("favorite_nurses")
}

/// استدعاء مباشر لكادر تمريضي لتكليف مُعلن — يحتوي قبول/رفض
model NurseInvitation {
  id          String           @id @default(cuid())
  postId      String
  nurseId     String
  receiverId  String
  status      InvitationStatus @default(PENDING)
  message     String?
  respondedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  nurse    User @relation("InvitedNurse", fields: [nurseId], references: [id], onDelete: Cascade)
  receiver User @relation("InvitingReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([postId, nurseId])
  @@index([nurseId])
  @@index([postId])
  @@index([receiverId])
  @@index([status])
  @@map("nurse_invitations")
}

// ============================================================
// الجولة 61 — خصوصية المستندات: طلب رسمي بإذن الإدارة
// (جداول جديدة كلياً — إضافي بحت ولا يمس أي جدول أو بيانات قائمة)
// ============================================================

/// حالة طلب رؤية مستندات الكادر
enum DocumentAccessStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

/// طلب رؤية مستندات كادر تمريضي/طبيب — يقدّمه المستلم الإداري أو مشرف
/// الأطباء مع بيان السبب، وتقبل الإدارة أو ترفض (مع ملاحظة اختيارية)،
/// ولها الحق في سحب المنح في أي وقت (يصبح الطلب REVOKED).
/// APPROVED = الصلاحية قائمة حتى تسحبها الإدارة — لا مدة انتهاء.
model DocumentAccessRequest {
  id           String               @id @default(cuid())
  requesterId  String
  targetId     String
  /// سبب الطلب — إجباري (10 أحرف على الأقل) ويظهر للإدارة عند القرار
  reason       String
  status       DocumentAccessStatus @default(PENDING)
  /// ملاحظة الإدارة عند القبول/الرفض/السحب
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  requester User  @relation("DocAccessRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User  @relation("DocAccessTarget", fields: [targetId], references: [id], onDelete: Cascade)
  reviewer  User? @relation("DocAccessReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([requesterId, status])
  @@index([targetId, status])
  @@index([status])
  @@map("document_access_requests")
}

/// سجل مشاهدات المستندات — شفافية كاملة: كل فتح لمحتوى مستندات كادر
/// بمنح إداري يُسجَّل (من شاهد ومتى) — لكل مشاهدة سطر مستقل.
model DocumentAccessLog {
  id        String   @id @default(cuid())
  requestId String
  viewerId  String
  targetId  String
  createdAt DateTime @default(now())

  @@index([targetId])
  @@index([viewerId])
  @@map("document_access_logs")
}

// ============================================================
// الجولة 66 — ميزة «فرصة | Forsah» — فرص العمل الصحية
// (جداول جديدة كلياً — إضافي بحت ولا يمس أي جدول أو بيانات قائمة)
// ============================================================
// Domain مستقل عن التكليفات: لا علاقة له بجداول Assignment/Post/Application
// القائمة، ويستخدم الكتالوجات الحالية (hospitals/specialties/departments/
// qualifications) بمراجع FK دون أي نسخ، والتقديم يرتبط بـ User ID الحالي
// دون إنشاء أي حساب أو ملف شخصي جديد.

/// حالة الفرصة — دورة الحياة الكاملة
/// الإغلاق (CLOSED) نهائي آمن server-side: يتوقف التقديم فوراً وتبقى كل
/// الطلبات والمقابلات والاختيارات والبيانات المالية وسجل التدقيق محفوظة —
/// لا حذف إطلاقاً (No Hard Delete).
enum OpportunityStatus {
  DRAFT /// مسودة — مرئية لمنشئها فقط
  PUBLISHED /// منشورة — مفتوحة للتقديم
  ACTIVE /// نشطة — قيد سير العمل (تبقى مفتوحة للتقديم حسب ما قرره HR)
  PAUSED /// متوقفة مؤقتاً — لا تقديم جديد حتى الاستئناف
  CLOSED /// مغلقة — من الإدارة أو HR المصرح له — لا تقديم جديد نهائياً
  ARCHIVED /// مؤرشفة — إدارية فقط بعد الإغلاق
}

/// نوع الراتب
enum OpportunitySalaryType {
  MONTHLY /// شهري
  DAILY /// يومي
  NEGOTIABLE /// حسب الاتفاق
}

/// حالة طلب التقديم على الفرصة — تعكس مراحل الـ Timeline
enum OpportunityApplicationStatus {
  PENDING /// قيد المراجعة
  REVIEWED /// تمت المراجعة
  INTERVIEW_INVITED /// مرشح للمقابلة
  INTERVIEW_CONFIRMED /// مقابلة مؤكدة
  INTERVIEW_DECLINED /// اعتذر عن حضور المقابلة
  SELECTED /// تم اختياره للموظف
  REJECTED /// غير مقبول
  WITHDRAWN /// منسحب (بتقديم المستخدم نفسه)
}

/// نمط المقابلة
enum OpportunityInterviewMode {
  ONSITE /// حضورية
  ONLINE /// عن بُعد
}

/// رد المرشح على دعوة المقابلة
enum OpportunityInterviewResponse {
  PENDING /// بانتظار الرد
  CONFIRMED /// أكد الحضور
  DECLINED /// اعتذر عن الحضور
}

/// نوع رسوم الفرصة — تتحكم الإدارة وحدها في القيم
enum OpportunityFeeType {
  PERCENTAGE /// نسبة من الراتب
  FIXED /// مبلغ ثابت
}

/// حالة العملية المالية في سجل «فرصة» المستقل
enum OpportunityTransactionStatus {
  PENDING /// معلقة
  AWAITING_PAYMENT /// بانتظار السداد
  PAID /// مسددة
  PARTIALLY_PAID /// مسددة جزئياً
  FAILED /// فاشلة
  CANCELLED /// ملغاة
  REFUNDED /// مستردة
  COMPLETED /// مكتملة
}

/// الجولة 70 — توقيت سداد رسوم الخدمة الذي يختاره المرشح بعد اختياره — شفافية كاملة
enum OpportunityPaymentTiming {
  WITHIN_FIRST_TEN_DAYS /// خلال أول 10 أيام من الدوام
  DIRECT /// دفع مباشر (عند الاختيار)
  AFTER_THREE_DAYS /// بعد ثلاثة أيام من الاختيار
}

/// الفرصة — وظيفة صحية معلنة يديرها حساب HR (أو الإدارة)
model Opportunity {
  id             String             @id @default(cuid())
  /// الرقم التسلسلي الاحترافي «فرصة رقم N» — يُولَّد تلقائياً
  number         Int                @default(0)
  title          String
  /// الجهة الصحية — من كتالوج الجهات الحالي (FK — لا نسخ)
  hospitalId     String
  /// نوع الكادر المستهدف — يُعيد استخدام تعداد الجمهور الحالي
  audience       Audience
  /// التخصص الطبي المطلوب — من كتالوج التخصصات الحالي (FK — لا نسخ) — null = بلا قيد
  specialtyId    String?
  /// القسم الطبي المطلوب — من كتالوج الأقسام الحالي (FK — لا نسخ) — null = بلا قيد
  departmentId   String?
  /// المؤهل المطلوب — من كتالوج المؤهلات الحالي (FK — لا نسخ) — null = بلا قيد
  qualificationId String?
  /// قيمة الراتب — null = غير محدد (مع NEGOTIABLE مثلاً)
  salaryAmount   Int?
  salaryType     OpportunitySalaryType @default(MONTHLY)
  /// عملة الراتب — YER | SAR | USD
  salaryCurrency String             @default("YER")
  /// بداية الدوام (HH:mm 24 ساعة)
  workStartTime  String?
  /// نهاية الدوام (HH:mm 24 ساعة)
  workEndTime    String?
  /// عدد الموظفين المطلوبين — يُحترم عند الاختيار
  positionsNeeded Int               @default(1)
  /// الجنس المطلوب — يُعيد استخدام التعداد الحالي
  gender         Gender             @default(ANY)
  /// نظام الإجازات (نص حر — مثال: «جمعة أسبوعياً + إجازة سنوية 21 يوماً»)
  vacations      String?
  /// النسبة من الفحوصات والإجراءات إن وجدت (٪)
  procedureSharePercent Float?
  /// سنوات الخبرة الدنيا المطلوبة — null = بلا قيد
  minYearsExperience Int?
  /// هل الترخيص المهني الساري شرط للتقديم؟
  licenseRequired Boolean           @default(false)
  /// المستندات المطلوبة — أسماء معروضة على المتقدم (مصطلحات عامة)
  requiredDocuments String[]        @default([])
  /// وصف الفرصة
  description    String?
  /// المهام والمسؤوليات
  responsibilities String?
  /// المزايا
  benefits       String?
  /// ملاحظات
  notes          String?
  status         OpportunityStatus @default(DRAFT)
  /// حساب HR المالك — منشئ الفرصة
  createdById    String
  publishedAt    DateTime?
  pausedAt       DateTime?
  /// من أغلق الفرصة (HR المصرح أو الإدارة)
  closedAt       DateTime?
  closedById     String?
  /// دور مَن أغلق — HR | ADMIN (سجل تدقيق دائم)
  closedByRole   String?
  archivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  hospital     Hospital     @relation(fields: [hospitalId], references: [id])
  specialty    Specialty?   @relation(fields: [specialtyId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  qualification Qualification? @relation(fields: [qualificationId], references: [id])
  createdBy    User         @relation("OpportunityCreator", fields: [createdById], references: [id])
  applications OpportunityApplication[]
  interviews   OpportunityInterview[]
  selections   OpportunitySelection[]
  transactions OpportunityTransaction[]

  @@index([status])
  @@index([createdById])
  @@index([hospitalId])
  @@index([audience, status])
  @@map("opportunities")
}

/// طلب تقديم كادر/طبيب على فرصة — يرتبط بـ User ID الحالي حصراً
/// (ممنوع إنشاء حساب أو ملف جديد — البيانات المهنية تُقرأ من الملف القائم)
model OpportunityApplication {
  id            String                         @id @default(cuid())
  opportunityId String
  userId        String
  status        OpportunityApplicationStatus   @default(PENDING)
  /// رسالة التقديم الاختيارية من المتقدم
  coverNote     String?
  /// لقطة JSON لنتيجة Eligibility لحظة التقديم (شفافية تاريخية)
  matchSnapshot String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews  OpportunityInterview[]
  selection   OpportunitySelection?

  @@unique([opportunityId, userId])
  @@index([userId])
  @@index([opportunityId, status])
  @@map("opportunity_applications")
}

/// دعوة مقابلة لمرشح — HR يرسل دفعة دعوات لعدة متقدمين
model OpportunityInterview {
  id             String                       @id @default(cuid())
  opportunityId  String
  applicationId  String
  /// المرشح (معرف تكرار للقراءة السريعة — نفس مستخدم الطلب)
  candidateId    String
  scheduledDate  DateTime
  /// وقت المقابلة HH:mm
  scheduledTime  String
  mode           OpportunityInterviewMode    @default(ONSITE)
  /// مكان المقابلة (حضورية) — مثال: «مبنى الإدارة — الطابق الثاني»
  location       String?
  /// العنوان التفصيلي
  address        String?
  /// رابط الخريطة إن أمكن
  mapUrl         String?
  notes          String?
  response       OpportunityInterviewResponse @default(PENDING)
  respondedAt    DateTime?
  createdById    String
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  opportunity Opportunity            @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  application OpportunityApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// المرشح — علاقة قراءة سريعة (نفس مستخدم الطلب)
  candidate   User                   @relation("OpportunityInterviewCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation("OpportunityInterviewCreator", fields: [createdById], references: [id])

  @@index([opportunityId])
  @@index([candidateId])
  @@index([scheduledDate])
  @@map("opportunity_interviews")
}

/// اختيار موظف — يُحترم عدد الموظفين المطلوبين ويُقفل بعده حسب حالة الفرصة
model OpportunitySelection {
  id             String   @id @default(cuid())
  opportunityId  String
  /// واحد لكل طلب تقديم — لا اختيار مكرر إطلاقاً
  applicationId  String   @unique
  candidateId    String
  selectedById   String
  note           String?
  createdAt      DateTime @default(now())

  opportunity Opportunity            @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  application OpportunityApplication @relation(fields: [applicationId], references: [id])
  /// المرشح — علاقة قراءة سريعة (نفس مستخدم الطلب)
  candidate   User                   @relation("OpportunitySelectionCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  selectedBy  User                   @relation("OpportunitySelectionCreator", fields: [selectedById], references: [id])

  @@unique([opportunityId, candidateId])
  @@index([opportunityId])
  @@index([candidateId])
  @@map("opportunity_selections")
}

/// العملية المالية — سجل مستقل تماماً عن النظام المالي للتكليفات
/// كل عملية مرتبطة باختيار واحد بمفتاح idempotency فريد يمنع التكرار
/// (الضغط المزدوج لا ينشئ عمليتين) — الحسابات integer-safe بالهلات
model OpportunityTransaction {
  id            String                      @id @default(cuid())
  opportunityId String
  selectionId   String                      @unique
  /// الراتب المرجعي لحظة الاحتساب (لقطة تاريخية)
  baseAmount    Int
  currency      String                      @default("YER")
  feeType       OpportunityFeeType          @default(PERCENTAGE)
  /// النسبة المئوية لحظة الاحتساب (لقطة) — لـ PERCENTAGE
  feePercent    Float?
  /// إجمالي رسوم الإدارة المحتسبة
  feeAmount     Int
  /// نسبة عمولة HR لحظة الاحتساب (لقطة)
  hrCommissionPercent Float
  /// مستحق HR
  hrCommissionAmount Int
  /// مستحق الإدارة (feeAmount - hrCommissionAmount)
  adminAmount   Int
  status        OpportunityTransactionStatus @default(AWAITING_PAYMENT)
  /// الجولة 70 — توقيت السداد الذي اختاره المرشح — null = لم يختر بعد
  paymentTiming         OpportunityPaymentTiming?
  /// لحظة اختيار المرشح للتوقيت
  paymentTimingChosenAt DateTime?
  /// موعد الاستحقاق التقديري المحسوب من التوقيت المختار — null = مرن (خلال أول 10 أيام من الدوام)
  paymentDueAt          DateTime?
  /// الجولة 71 — إثبات دفع الرسوم المرفوع من المرشح (صورة مخزنة في قاعدة البيانات) — null = لم يرفع بعد
  paymentProofUrl         String?
  paymentProofFileName    String?
  paymentProofUploadedAt  DateTime?
  /// الجولة 71 — رفض الإدارة للإثبات: تُمسح حقول الإثبات وتُسجّل هذه الحقول للشفافية ويمكن إعادة الرفع
  paymentProofRejectedAt    DateTime?
  paymentProofRejectionNote String?
  /// مفتاح منع التكرار — فريد على مستوى القاعدة
  idempotencyKey String                     @unique
  note          String?
  paidAt        DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([status])
  @@map("opportunity_financial_transactions")
}

/// سجل تدقيق «فرصة» — كل عملية حساسة تُسجَّل (من/ماذا/على أي كيان/متى)
/// actorId nullable مع SetNull: حذف مستخدم لا يحذف التاريخ أبدًا
model OpportunityAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  /// دور المنفذ لحظة التنفيذ — HR | ADMIN (يبقى بعد أي تغيير أدوار)
  actorRole  String
  /// مفتاح العملية — مثال: OPPORTUNITY_CREATE / OPPORTUNITY_PUBLISH / OPPORTUNITY_CLOSED_BY_ADMIN
  action     String
  entityType String
  entityId   String
  /// تفاصيل JSON اختيارية (قيم قبل/بعد مثلاً)
  meta       String?
  createdAt  DateTime @default(now())

  actor User? @relation("ForsahAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("opportunity_audit_logs")
}

/// سجل مشاهدات الخصوصية — من شاهد ملف متقدم (وماذا) ومتى — شفافية كاملة
model OpportunityViewLog {
  id            String   @id @default(cuid())
  /// المشاهد (HR/الإدارة)
  viewerId      String
  /// صاحب الملف المشاهد
  targetId      String
  /// الفرصة المرتبطة إن وجدت
  opportunityId String?
  /// نوع المشاهدة — PROFILE | DOCUMENTS | RATINGS | CONTACT
  kind          String
  createdAt     DateTime @default(now())

  viewer User    @relation("ForsahViewViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@index([targetId])
  @@index([viewerId])
  @@index([opportunityId])
  @@map("opportunity_view_logs")
}

/// الجولة 69 — أرشفة لقطة الحذف: الحذف النهائي للفرص المغلقة/المؤرشفة (إدارة حصراً)
/// لا يضيع أي سجل مالي أو إداري أبداً: قبل حذف الفرصة تُخزَّن لقطة JSON كاملة
/// (الفرصة + كل الطلبات + المقابلات + الاختيارات + العمليات المالية) هنا قابلة للاسترجاع.
model OpportunityDeletionArchive {
  id            String   @id @default(cuid())
  /// معرف الفرصة المحذوفة — فريد (أرشفة واحدة لكل فرصة)
  opportunityId String   @unique
  /// الرقم التسلسلي والعنوان والجهة لحظة الحذف (عرض سريع بلا تحليل JSON)
  number        Int
  title         String
  hospitalName  String
  audience      String
  status        String
  createdByName String?
  /// اللقطة الكاملة — JSON نصي مستقل يبقى بعد حذف الفرصة وسجلاتها
  snapshotJson  String
  /// عدادات ما حُذف مع الفرصة (cascade) — للعرض والتدقيق
  applicationsCount Int    @default(0)
  interviewsCount   Int    @default(0)
  selectionsCount   Int    @default(0)
  transactionsCount Int    @default(0)
  /// من نفّذ الحذف (الإدارة المنفّذة حصراً)
  deletedById   String
  deletedByRole String
  deletedAt     DateTime @default(now())

  @@index([deletedAt])
  @@map("opportunity_deletion_archives")
}
