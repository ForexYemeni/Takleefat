# ============================================================
# تكليفات | Takleefat — Environment Variables
# انسخ هذا الملف إلى ".env" واملأ القيم الحقيقية
# ⚠️ لا ترفع ملف .env إلى GitHub مطلقاً
# ============================================================

# ---------- قاعدة البيانات (إلزامي) ----------
# PostgreSQL سحابي: Neon / Supabase / Vercel Postgres
# مثال: postgresql://user:password@host:5432/takleefat?sslmode=require
DATABASE_URL=

# ---------- المصادقة (إلزامي) ----------
# مفتاح تشفير الجلسات — أنشئه بالأمر: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=

# رابط الموقع في الإنتاج (بدون / في النهاية)
# مثال: https://takleefat.vercel.app
NEXTAUTH_URL=

# ---------- حساب المدير الافتراضي (إلزامي) ----------
# يُنشأ حساب المدير تلقائياً عند أول تشغيل إذا لم يوجد أي مدير
# ⚠️ غيّر كلمة المرور الافتراضية فوراً بعد أول تسجيل دخول
ADMIN_PHONE=
ADMIN_PASSWORD=

# ---------- التخزين السحابي للملفات (إلزامي في الإنتاج) ----------
# متوافق مع S3: Cloudflare R2 / Supabase Storage / AWS S3
# مثال Endpoint لـ Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
# المنطقة — لـ Cloudflare R2 استخدم: auto
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# الرابط العام لعرض الملفات (اختياري — مثال رابط R2 العام: https://pub-xxx.r2.dev)
STORAGE_PUBLIC_URL=
